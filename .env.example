# ============================================
# J.A.R.V.I.S. Environment Variables
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Picovoice Access Key (from https://console.picovoice.ai/)
PICOVOICE_ACCESS_KEY=your_picovoice_key_here

# Wake word sensitivity (0.0 to 1.0, default 0.7)
WAKE_WORD_SENSITIVITY=0.7

# Voice settings
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+10%
TTS_VOLUME=+0%

# Gmail OAuth credentials file path (optional)
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json

# Anthropic/OpenAI key (optional, if you want alternate LLM)
# OPENAI_API_KEY=your_openai_key_here
